{
	"name": "create-font-workspace",
	"private": true,
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"scripts": {
		"build": "vp run -r --cache build",
		"change": "changeset",
		"check": "pnpm run build && pnpm run \"/^check:.*/\"",
		"check:agents": "agents validate",
		"check:clippy": "mise exec -- cargo clippy --workspace --all-targets -- -D warnings",
		"check:eslint": "pnpm -r check:eslint",
		"check:fmt": "vp run dprint-plugin-fea#build && node ./packages/create-art/source-format/src/cli.ts check fonts designs && dprint check",
		"check:lasertag": "pnpm -r check:lasertag",
		"check:vp": "vp check --no-fmt",
		"check:peers": "pnpm peers check",
		"check:rustfmt": "mise exec -- cargo fmt --all -- --check",
		"cov": "pnpm --filter @create-font/editor run cov",
		"create-design": "node ./apps/create-design/src/create-design-cli.ts",
		"create-font": "node ./apps/create-font/src/create-font-cli.ts",
		"design": "node ./apps/create-design/src/design-cli.ts",
		"dev": "node ./scripts/dev.ts",
		"dev:design": "pnpm --filter create-design dev",
		"dev:font": "pnpm --filter create-font dev",
		"fmt": "mise exec -- cargo fmt --all && vp run dprint-plugin-fea#build && node ./packages/create-art/source-format/src/cli.ts fmt fonts designs && dprint fmt",
		"font": "node ./apps/create-font/src/font-cli.ts",
		"release:publish": "pnpm build && changeset publish",
		"release:version": "vp run --ignore-depends-on dprint-plugin-fea#build && changeset version",
		"staged": "vp staged",
		"test": "node --test ./scripts/dev-ports.test.ts ./scripts/dev-processes.test.ts ./scripts/server-shutdown.test.ts && mise exec -- cargo test --workspace && pnpm -r test",
		"test:watch": "vp run -r --parallel --no-cache test:watch"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.26.0",
		"@dprint/oxc": "0.44.0",
		"@dprint/toml": "0.9.0",
		"@types/node": "26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/parser": "8.71.1",
		"@vitejs/plugin-react": "6.1.2",
		"agents.yaml": "0.3.0",
		"create-design": "workspace:*",
		"create-font": "workspace:*",
		"dprint": "0.61.1",
		"dprint-plugin-fea": "workspace:*",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.5",
		"dprint-plugin-yaml": "0.6.0",
		"eslint": "10.12.0",
		"happy-dom": "20.14.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": "26.11.1",
		"pnpm": "12.10.1"
	}
}
