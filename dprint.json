{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"extends": "./dprint.base.json",
	"includes": [
		"**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,md,mdx,css,astro,toml,yml,yaml,fea}"
	],
	"fea": {
		"associations": [
			"**/*.fea"
		],
		"lineWidth": 80,
		"indentWidth": 2,
		"useTabs": false,
		"newLineKind": "lf"
	},
	"plugins": [
		"./node_modules/dprint-plugin-fea/plugin.wasm"
	]
}
