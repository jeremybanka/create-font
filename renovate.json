{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"automerge": true,
	"branchConcurrentLimit": 9,
	"internalChecksFilter": "strict",
	"minimumReleaseAge": "1 day",
	"prConcurrentLimit": 3,
	"prHourlyLimit": 9,
	"pruneBranchAfterAutomerge": true,
	"pruneStaleBranches": true,
	"statusCheckWhen": { "minimumReleaseAge": "never" },
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github\\/actions\\/setup\\/action\\.yml$/"],
			"matchStrings": [
				"uses: jdx\\/mise-action@\\S+(?:\\s+#.*)?\\s+      with:\\s+        version: (?<currentValue>\\S+)"
			],
			"depNameTemplate": "jdx/mise",
			"datasourceTemplate": "github-releases",
			"versioningTemplate": "semver-coerced"
		}
	],
	"packageRules": [
		{
			"matchPackageNames": ["jdx/mise"],
			"matchDatasources": ["github-releases"],
			"ignoreUnstable": true
		},
		{
			"groupName": "vite toolchain",
			"matchPackageNames": [
				"vite",
				"vite-node",
				"vite-plus",
				"viteplus",
				"vitest",
				"@vitejs/**",
				"@vitest/**",
				"@voidzero-dev/vite-plus-*"
			]
		},
		{
			"groupName": "changesets",
			"matchPackageNames": ["@changesets/**", "changesets/action"]
		},
		{
			"matchManagers": ["github-actions"],
			"dependencyDashboardApproval": true
		},
		{
			"matchPackageNames": [
				"agents.yaml",
				"atom.io",
				"comline",
				"lasertag",
				"mondrian.pdf",
				"treetrunks"
			],
			"minimumReleaseAge": null
		}
	]
}
