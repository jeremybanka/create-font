{
	"name": "create-foley",
	"version": "0.1.0",
	"description": "Create, edit, validate, and render procedural sound-effect projects",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "apps/create-foley"
	},
	"type": "module",
	"bin": {
		"create-foley": "./dist/create-foley-cli.js",
		"foley": "./dist/foley-cli.js"
	},
	"files": ["dist", "src", "README.md"],
	"exports": {
		".": {
			"development": "./src/server.ts",
			"types": "./src/server.ts",
			"import": "./dist/server.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json --noEmit && node ./scripts/build.ts",
		"dev": "node ./scripts/dev.ts",
		"test": "vp test --config=./vitest.config.ts"
	},
	"dependencies": {
		"@create-foley/audio": "workspace:*",
		"@create-foley/editor": "workspace:*",
		"@create-foley/source": "workspace:*",
		"@elysia/node": "1.4.6",
		"@elysia/static": "1.4.11",
		"elysia": "1.4.29",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"vite": "8.2.0"
	},
	"devDependencies": {
		"@types/node": "25.9.5",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"vite-plus": "0.2.8",
		"vitest": "4.1.10"
	},
	"engines": { "node": ">=22.0.0" }
}
