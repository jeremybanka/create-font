{
	"name": "create-design",
	"version": "0.3.2",
	"description": "Create, build, validate, export, and edit create-design source projects",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "apps/create-design"
	},
	"type": "module",
	"bin": {
		"create-design": "./dist/create-design-cli.js",
		"design": "./dist/design-cli.js"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"OUTPUT-EXCEPTION.txt"
	],
	"exports": {
		".": {
			"development": "./src/server.ts",
			"types": "./src/server.ts",
			"import": "./src/server.ts"
		},
		"./source": {
			"development": "./src/source-service.ts",
			"types": "./src/source-service.ts",
			"import": "./src/source-service.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "node ./scripts/build.ts",
		"check:eslint": "eslint \"src/**/*.{ts,tsx}\"",
		"dev": "node ./scripts/dev.ts",
		"test": "vp test --config=./vitest.config.ts"
	},
	"dependencies": {
		"@create-art/ui-layout": "workspace:*",
		"@create-art/source-rpc": "workspace:*",
		"@create-design/ai": "workspace:*",
		"@create-design/editor": "workspace:*",
		"@create-design/model": "workspace:*",
		"@create-design/pdf": "workspace:*",
		"@create-design/png": "workspace:*",
		"@create-design/svg": "workspace:*",
		"@create-design/text": "workspace:*",
		"@create-design/source": "workspace:*",
		"@elysia/node": "1.4.6",
		"@elysia/static": "1.4.11",
		"comline": "0.5.2",
		"elysia": "1.4.30",
		"zod": "4.5.1"
	},
	"devDependencies": {
		"@create-font/target": "workspace:*",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.1",
		"@typescript-eslint/parser": "8.68.0",
		"@typescript-eslint/utils": "8.68.0",
		"@types/node": "25.9.5",
		"atom.io": "0.52.1",
		"eslint": "10.9.1",
		"happy-dom": "20.11.13",
		"jiti": "2.7.0",
		"lasertag": "0.7.0",
		"mondrian.pdf": "0.1.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": "26.8.1"
	}
}
