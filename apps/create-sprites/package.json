{
	"name": "create-sprites",
	"version": "0.1.0",
	"description": "Source-first pixel art, spriting, and frame animation tool for the create-art family",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "apps/create-sprites"
	},
	"type": "module",
	"bin": {
		"create-sprites": "./dist/create-sprites-cli.js",
		"sprites": "./dist/sprites-cli.js"
	},
	"files": ["dist", "src", "README.md", "OUTPUT-EXCEPTION.txt"],
	"exports": {
		".": {
			"development": "./src/server.ts",
			"types": "./src/server.ts",
			"import": "./dist/server.js"
		},
		"./model": {
			"development": "./src/model.ts",
			"types": "./src/model.ts",
			"import": "./dist/model.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json --noEmit && node ./scripts/build.ts",
		"dev": "node ./scripts/dev.ts",
		"test": "vp test --config=./vitest.config.ts"
	},
	"dependencies": {
		"@create-art/editor": "workspace:*",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@types/node": "25.9.5",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"happy-dom": "20.11.1",
		"vite": "8.2.0",
		"vite-plus": "0.2.8",
		"vitest": "4.1.10"
	},
	"engines": { "node": "26.7.0" }
}
