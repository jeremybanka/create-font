{
	"name": "create-font",
	"version": "0.3.17",
	"description": "Repository-local CLI and browser server for create-font font projects",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "apps/create-font"
	},
	"type": "module",
	"bin": {
		"create-font": "./dist/create-font-cli.js",
		"create-font-fea-lsp": "./dist/fea-lsp.js",
		"font": "./dist/font-cli.js"
	},
	"files": [
		"dist",
		"src",
		"tsconfig.json",
		"README.md",
		"OUTPUT-EXCEPTION.txt"
	],
	"exports": {
		".": {
			"development": "./src/server.ts",
			"types": "./src/server.ts",
			"bun": "./dist/server.js",
			"import": "./dist/server.js"
		},
		"./rpc": {
			"development": "./src/rpc.ts",
			"types": "./src/rpc.ts",
			"bun": "./dist/rpc.js",
			"import": "./dist/rpc.js"
		},
		"./rpc-client": {
			"development": "./src/rpc-client.ts",
			"types": "./src/rpc-client.ts",
			"browser": "./dist/rpc-client.js",
			"import": "./dist/rpc-client.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "node ./scripts/build.ts",
		"dev": "node ./scripts/dev.ts",
		"test": "pnpm run test:unit && pnpm run test:e2e && pnpm run test:node-server",
		"test:bun-server": "node ./scripts/build-development.ts && bun --conditions=development ./tests/runtime-server-smoke.ts",
		"test:e2e": "vp test --config ./vitest.e2e.config.ts",
		"test:unit": "pnpm run test:unit-interfaces && pnpm run test:unit-source-pipeline",
		"test:unit-interfaces": "node ./scripts/build-development.ts && vp test --exclude ./tests/build.test.ts --exclude ./tests/source-service.test.ts",
		"test:unit-source-pipeline": "vp test ./tests/build.test.ts ./tests/source-service.test.ts",
		"test:node-server": "node --conditions=development --test ./tests/node-server.node.ts"
	},
	"dependencies": {
		"@create-art/source-format": "workspace:*",
		"@create-art/source-rpc": "workspace:*",
		"@create-font/editor": "workspace:*",
		"@create-font/fea-rs-wasm": "workspace:*",
		"@create-font/server": "workspace:*",
		"@create-font/source": "workspace:*",
		"@create-font/states": "workspace:*",
		"@create-font/target": "workspace:*",
		"@vscode/vsce": "3.9.2",
		"@elysia/node": "1.4.6",
		"@elysia/static": "1.4.11",
		"comline": "0.5.1",
		"elysia": "1.4.29",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"rolldown": "1.2.3",
		"vscode-languageclient": "10.1.0",
		"vscode-languageserver": "10.1.0",
		"vscode-languageserver-textdocument": "1.0.12",
		"vite": "8.2.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/node": "25.9.5",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"atom.io": "0.51.1",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
