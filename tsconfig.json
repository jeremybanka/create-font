{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"erasableSyntaxOnly": true,
		"exactOptionalPropertyTypes": true,
		"lib": ["ES2024"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"paths": {
			"@create-art/editor": ["./packages/editor/src/index.ts"],
			"@create-design/editor/browser": [
				"./packages/design-editor/src/browser.ts"
			],
			"@create-design/editor/model": [
				"./packages/design-editor/src/document.ts"
			],
			"@create-design/editor/source-session": [
				"./packages/design-editor/src/source-session.ts"
			],
			"@create-art/preact-konva": ["./packages/preact-konva/src/index.ts"],
			"@create-font/source": ["./packages/font-source/src/index.ts"],
			"@create-font/states": ["./packages/font-states/src/index.ts"],
			"@create-font/target": ["./packages/font-target/src/index.ts"]
		},
		"rootDir": ".",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024",
		"types": []
	},
	"include": ["**/*.ts", "*.d.ts"],
	"exclude": [
		"packages/editor",
		"packages/font-editor",
		"packages/design-editor",
		"packages/preact-konva",
		"packages/create-font"
	]
}
