{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"erasableSyntaxOnly": true,
		"exactOptionalPropertyTypes": true,
		"lib": ["ES2024"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"paths": {
			"@create-font/preact-konva": ["./packages/preact-konva/src/index.ts"],
			"@create-font/source": ["./packages/source/src/index.ts"],
			"@create-font/states": ["./packages/states/src/index.ts"],
			"@create-font/target": ["./packages/target/src/index.ts"]
		},
		"rootDir": ".",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024",
		"types": []
	},
	"include": ["**/*.ts", "*.d.ts"],
	"exclude": [
		"packages/editor",
		"packages/preact-konva",
		"packages/create-font"
	]
}
