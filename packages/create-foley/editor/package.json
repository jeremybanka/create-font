{
	"name": "@create-foley/editor",
	"version": "0.1.0",
	"description": "Browser sound-effect designer for create-foley projects",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/create-foley/editor"
	},
	"type": "module",
	"sideEffects": ["**/*.css"],
	"publishConfig": { "access": "public" },
	"files": ["dist", "src"],
	"exports": {
		".": {
			"development": "./src/browser.ts",
			"types": "./src/browser-api.ts",
			"browser": "./dist/browser/editor.js",
			"import": "./dist/browser/editor.js"
		},
		"./browser": {
			"development": "./src/browser.ts",
			"types": "./src/browser-api.ts",
			"browser": "./dist/browser/editor.js",
			"import": "./dist/browser/editor.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json --noEmit && node ./scripts/build.ts",
		"check:lasertag": "lasertag check \"src/**/*.module.css\"",
		"test": "vp test --passWithNoTests"
	},
	"dependencies": {
		"@create-art/editor": "workspace:*",
		"@create-art/vector-geometry": "workspace:*",
		"@create-foley/audio": "workspace:*",
		"@create-foley/source": "workspace:*",
		"@radix-ui/react-icons": "^1.3.2",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@types/node": "25.9.5",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"lasertag": "0.7.0",
		"vite": "8.2.0",
		"vite-plus": "0.2.8",
		"vitest": "4.1.10"
	},
	"engines": { "node": ">=22.0.0" }
}
