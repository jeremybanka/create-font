{
	"name": "@create-design/editor",
	"version": "0.3.0",
	"description": "Browser-based vector design editor for create-design documents",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/create-design/editor"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"src",
		"OUTPUT-EXCEPTION.txt"
	],
	"exports": {
		".": {
			"types": "./src/browser-api.ts",
			"browser": "./dist/browser/editor.js",
			"import": "./dist/browser/editor.js"
		},
		"./browser": {
			"development": "./src/browser.ts",
			"types": "./src/browser-api.ts",
			"browser": "./dist/browser/editor.js",
			"import": "./dist/browser/editor.js"
		},
		"./source-session": {
			"development": "./src/source-session.ts",
			"types": "./src/source-session.ts",
			"import": "./src/source-session.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "node ./scripts/build.ts",
		"check:eslint": "eslint \"src/**/*.{ts,tsx}\"",
		"check:lasertag": "lasertag check \"src/**/*.module.css\"",
		"test": "vp test"
	},
	"dependencies": {
		"@create-art/editor": "workspace:*",
		"@create-art/source-rpc": "workspace:*",
		"@create-art/vector-geometry": "workspace:*",
		"@create-design/model": "workspace:*",
		"@create-design/pdf": "workspace:*",
		"@create-design/png": "workspace:*",
		"@create-design/svg": "workspace:*",
		"@create-design/source": "workspace:*",
		"@create-design/text": "workspace:*",
		"@radix-ui/react-icons": "^1.3.2",
		"atom.io": "0.52.1",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@types/node": "25.9.5",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@typescript-eslint/parser": "8.67.0",
		"@typescript-eslint/utils": "8.67.0",
		"eslint": "10.8.1",
		"happy-dom": "20.11.2",
		"jiti": "2.7.0",
		"lasertag": "0.7.0",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": "26.7.0"
	}
}
