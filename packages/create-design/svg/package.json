{
	"name": "@create-design/svg",
	"version": "0.1.2",
	"description": "Headless SVG projection, serialization, preflight, and import for create-design documents",
	"license": "MPL-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/create-design/svg"
	},
	"type": "module",
	"sideEffects": false,
	"publishConfig": { "access": "public" },
	"files": ["dist", "src", "README.md"],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp pack",
		"profile": "node ./scripts/profile-svg-compilation.ts",
		"test": "vp test"
	},
	"dependencies": {
		"@create-design/model": "workspace:*",
		"@create-design/source": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "25.9.5",
		"vitest": "catalog:"
	},
	"engines": { "node": ">=22.0.0" }
}
