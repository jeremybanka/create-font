{
	"name": "create-design",
	"version": "0.1.2",
	"description": "Browser-based vector design editor with native RGB and CMYK PDF export",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/create-design"
	},
	"type": "module",
	"bin": {
		"create-design": "./src/cli.ts"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"exports": {
		".": {
			"development": "./src/server.ts",
			"types": "./src/server.ts",
			"import": "./src/server.ts"
		},
		"./source": {
			"development": "./src/source-service.ts",
			"types": "./src/source-service.ts",
			"import": "./src/source-service.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json --noEmit && node ./scripts/build.ts",
		"check:eslint": "eslint \"src/**/*.{ts,tsx}\"",
		"check:lasertag": "lasertag check \"src/**/*.module.css\"",
		"dev": "node ./scripts/dev.ts",
		"profile:pdf": "node ./scripts/profile-pdf-compilation.ts",
		"test": "vp test --config=./vitest.config.ts"
	},
	"dependencies": {
		"@create-art/source-rpc": "workspace:*",
		"@create-design/source": "workspace:*",
		"@create-font/editor": "workspace:*",
		"@create-font/preact-konva": "workspace:*",
		"@radix-ui/react-icons": "^1.3.2",
		"@elysia/node": "1.4.6",
		"@elysia/static": "1.4.11",
		"elysia": "1.4.29",
		"mondrian.pdf": "0.0.0",
		"preact": "10.29.7"
	},
	"devDependencies": {
		"@preact/preset-vite": "2.10.6",
		"@typescript-eslint/parser": "8.65.0",
		"@typescript-eslint/utils": "8.65.0",
		"@types/node": "25.9.5",
		"atom.io": "0.50.1",
		"eslint": "10.8.0",
		"happy-dom": "20.11.1",
		"jiti": "2.7.0",
		"lasertag": "0.6.7",
		"react": "npm:@preact/compat@18.3.2",
		"react-dom": "npm:@preact/compat@18.3.2",
		"vite": "8.2.0",
		"vite-plus": "0.2.5",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": "26.5.1"
	}
}
