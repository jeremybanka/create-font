			"types": "./dist/parser.d.mts",
			"import": "./dist/parser.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp pack",
		"test": "vp test"
	},
	"dependencies": {
		"@create-font/source": "workspace:*",
		"@create-font/states": "workspace:*"
	},
	"devDependencies": {
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
