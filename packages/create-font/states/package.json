{
	"name": "@create-font/states",
	"version": "0.7.3",
	"description": "Atom.io state and compilation model for variable-font editors",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/create-font/states"
	},
	"license": "MPL-2.0",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/*.d.mts",
		"dist/*.d.mts.map",
		"dist/*.mjs",
		"dist/*.mjs.map",
		"src"
	],
	"scripts": {
		"build": "vp pack",
		"check:eslint": "eslint \"src/**/*.ts\"",
		"dev": "vp pack --watch --no-clean",
		"test": "vp test",
		"test:watch": "vp test watch"
	},
	"dependencies": {
		"@create-art/vector-geometry": "workspace:*",
		"@create-font/server": "workspace:*",
		"@create-font/target": "workspace:*",
		"atom.io": "0.54.2"
	},
	"devDependencies": {
		"@atom.io/eslint-plugin": "0.1.1",
		"@typescript-eslint/parser": "8.72.1",
		"@typescript-eslint/utils": "8.72.1",
		"eslint": "10.13.0",
		"jiti": "2.7.0",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
