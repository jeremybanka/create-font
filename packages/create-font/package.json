{
	"name": "create-font",
	"version": "0.3.0",
	"description": "Repository-local CLI and browser server for create-font font projects",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/create-font"
	},
	"type": "module",
	"bin": {
		"create-font": "./dist/create-font-cli.js",
		"font": "./dist/font-cli.js"
	},
	"files": [
		"dist",
		"src",
		"tsconfig.json",
		"README.md"
	],
	"exports": {
		".": {
			"development": "./src/server.ts",
			"types": "./src/server.ts",
			"bun": "./dist/server.js",
			"import": "./dist/server.js"
		},
		"./rpc": {
			"development": "./src/rpc.ts",
			"types": "./src/rpc.ts",
			"bun": "./dist/rpc.js",
			"import": "./dist/rpc.js"
		},
		"./rpc-client": {
			"development": "./src/rpc-client.ts",
			"types": "./src/rpc-client.ts",
			"browser": "./dist/rpc-client.js",
			"import": "./dist/rpc-client.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun run ./scripts/build.ts",
		"dev": "bun run ./scripts/build-development.ts && bun run ./scripts/dev.ts",
		"test": "bun run ./scripts/build-development.ts && bun run test:browser-bundle && bun test --conditions=development --path-ignore-patterns='**/preact-compat.test.ts'",
		"test:browser-bundle": "bun test --conditions=development ./tests/preact-compat.test.ts"
	},
	"dependencies": {
		"@elysia/static": "1.4.11",
		"@create-font/server": "workspace:*",
		"@create-font/source": "workspace:*",
		"@create-font/states": "workspace:*",
		"@create-font/target": "workspace:*",
		"comline": "0.5.1",
		"elysia": "1.4.29",
		"preact": "10.29.7",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@create-font/editor": "workspace:*",
		"@types/bun": "npm:bun-types@1.3.14",
		"@types/node": "25.9.5"
	}
}
