{
	"name": "@create-font/editor",
	"version": "0.9.2",
	"description": "Interactive variable-font editor for the create-font state model",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/create-font/editor"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"src/browser-api.ts",
		"OUTPUT-EXCEPTION.txt"
	],
	"exports": {
		".": {
			"types": "./src/browser-api.ts",
			"browser": "./dist/browser/editor.js",
			"import": "./dist/browser/editor.js"
		},
		"./browser": {
			"types": "./src/browser-api.ts",
			"browser": "./dist/browser/editor.js",
			"import": "./dist/browser/editor.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "node ./scripts/build.ts",
		"check:eslint": "eslint \"src/**/*.{ts,tsx}\"",
		"check:lasertag": "lasertag check \"src/**/*.module.css\"",
		"profile:live-font": "node --conditions=development ./scripts/profile-live-compilation.ts",
		"test": "vp test",
		"test:coverage": "vp test run --coverage"
	},
	"dependencies": {
		"@create-art/editor": "workspace:*",
		"@create-art/vector-geometry": "workspace:*",
		"@create-font/states": "workspace:*",
		"@create-font/target": "workspace:*",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@radix-ui/react-icons": "^1.3.2",
		"@typescript-eslint/parser": "8.69.0",
		"@typescript-eslint/utils": "8.69.0",
		"@vitest/coverage-v8": "catalog:",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.6",
		"atom.io": "0.52.2",
		"eslint": "10.9.1",
		"happy-dom": "20.13.2",
		"jiti": "2.7.0",
		"lasertag": "0.8.0",
		"treetrunks": "0.1.11",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": "26.8.1"
	}
}
