{
	"name": "@create-art/source-rpc",
	"version": "0.1.1",
	"description": "Revisioned JSON source workspace contracts, RPC, and synchronization primitives",
	"license": "MPL-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/create-art/source-rpc"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/*.d.mts",
		"dist/*.d.mts.map",
		"dist/*.mjs",
		"dist/*.mjs.map",
		"src"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./client": {
			"development": "./src/client.ts",
			"types": "./dist/client.d.mts",
			"browser": "./dist/client.mjs",
			"import": "./dist/client.mjs"
		},
		"./server": {
			"development": "./src/server.ts",
			"types": "./dist/server.d.mts",
			"import": "./dist/server.mjs"
		},
		"./node": {
			"development": "./src/node.ts",
			"types": "./dist/node.d.mts",
			"import": "./dist/node.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch --no-clean",
		"test": "vp test"
	},
	"dependencies": {
		"elysia": "1.4.29"
	},
	"devDependencies": {
		"@types/node": "25.9.5",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
