{
	"name": "@create-art/source-format",
	"version": "0.2.4",
	"description": "Versioned dprint formatting contract for create-art source files",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/create-art/source-format"
	},
	"license": "MPL-2.0",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"development": {
				"browser": "./src/browser.ts",
				"node": "./src/index.ts",
				"default": "./src/browser.ts"
			},
			"browser": "./dist/browser.mjs",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./browser": {
			"development": "./src/browser.ts",
			"types": "./dist/browser.d.mts",
			"import": "./dist/browser.mjs"
		},
		"./dprint.json": "./dprint.json",
		"./package.json": "./package.json"
	},
	"bin": { "create-source-format": "./dist/cli.mjs" },
	"files": ["dist", "dprint.json", "README.md"],
	"scripts": { "build": "vp pack", "test": "vp test" },
	"dependencies": {
		"@dprint/formatter": "0.5.1",
		"@dprint/json": "0.24.0",
		"dprint-plugin-fea": "workspace:*"
	},
	"devDependencies": { "@types/node": "26.6.1", "vitest": "catalog:" },
	"peerDependencies": { "dprint": ">=0.55.2 <0.58.0" },
	"peerDependenciesMeta": { "dprint": { "optional": true } },
	"engines": { "node": ">=22.0.0" },
	"publishConfig": { "access": "public" }
}
