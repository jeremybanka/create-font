{
	"name": "@create-art/editor",
	"version": "0.2.1",
	"description": "Shared editor controls, tiling, canvas, and vector interaction foundations for create-art applications",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/create-art/editor"
	},
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"src",
		"OUTPUT-EXCEPTION.txt"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./src/index.ts",
			"browser": "./dist/editor.js",
			"import": "./dist/editor.js"
		},
		"./styles.css": "./dist/editor.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"benchmark:runtime": "node --expose-gc ./scripts/benchmark-runtime.ts",
		"build": "node ./scripts/build.ts",
		"test": "vp test"
	},
	"dependencies": {
		"@create-art/ui-layout": "workspace:*",
		"@create-art/vector-geometry": "workspace:*",
		"@floating-ui/dom": "^1.8.0",
		"@radix-ui/react-icons": "^1.3.2",
		"konva": "10.3.2",
		"react-konva": "19.2.5"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@types/node": "25.9.5",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"happy-dom": "20.12.0",
		"lasertag": "0.7.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": "26.8.1"
	}
}
