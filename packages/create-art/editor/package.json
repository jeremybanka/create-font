{
	"name": "@create-art/editor",
	"version": "0.2.0",
	"description": "Shared editor controls, tiling, canvas, and vector interaction foundations for create-art applications",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/create-art/editor"
	},
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"src",
		"OUTPUT-EXCEPTION.txt"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./src/index.ts",
			"browser": "./dist/editor.js",
			"import": "./dist/editor.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"benchmark:runtime": "node --expose-gc ./scripts/benchmark-runtime.ts",
		"build": "tsc --project tsconfig.json --noEmit && node ./scripts/build.ts",
		"test": "vp test"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@radix-ui/react-icons": "^1.3.2",
		"konva": "10.3.0",
		"react-konva": "19.2.5"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@types/node": "25.9.5",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"happy-dom": "20.11.1",
		"lasertag": "0.7.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"vite": "8.2.0",
		"vite-plus": "0.2.8",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": "26.7.0"
	}
}
