{
	"name": "@trigraph/source",
	"version": "0.0.0",
	"description": "A deterministic, versioned JSON source format for trigraph editor state",
	"files": [
		"dist/*.d.mts",
		"dist/*.d.mts.map",
		"dist/*.mjs",
		"dist/*.mjs.map",
		"src"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch --no-clean",
		"test": "vp test"
	},
	"dependencies": {
		"@trigraph/states": "workspace:*",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
