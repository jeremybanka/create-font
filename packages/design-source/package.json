{
	"name": "@create-design/source",
	"version": "0.1.0",
	"description": "Deterministic source formats for create-design documents",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/design-source"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/*.d.mts",
		"dist/*.d.mts.map",
		"dist/*.mjs",
		"dist/*.mjs.map",
		"src",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch --no-clean",
		"test": "vp test"
	},
	"dependencies": {
		"zod": "4.4.3"
	},
	"devDependencies": {
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
