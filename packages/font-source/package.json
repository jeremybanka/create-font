{
	"name": "@create-font/source",
	"version": "0.2.6",
	"description": "A deterministic, versioned JSON source format for create-font editor state",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/font-source"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/*.d.mts",
		"dist/*.d.mts.map",
		"dist/*.mjs",
		"dist/*.mjs.map",
		"src"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./browser": {
			"development": "./src/browser.ts",
			"types": "./dist/browser.d.mts",
			"browser": "./dist/browser.mjs",
			"import": "./dist/browser.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch --no-clean",
		"test": "vp test"
	},
	"dependencies": {
		"@create-art/source-format": "workspace:*",
		"@create-font/fea-rs-wasm": "workspace:*",
		"@create-font/states": "workspace:*",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
