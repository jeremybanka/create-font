		"atom.io": "0.50.0",
		"preact": "10.29.7"
	},
	"devDependencies": {
		"@typescript-eslint/parser": "8.64.0",
		"@typescript-eslint/utils": "8.64.0",
		"eslint": "10.7.0",
		"jiti": "2.7.0",
		"lasertag": "0.5.2",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": "26.5.0"
	}
