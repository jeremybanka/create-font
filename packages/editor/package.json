{
	"name": "@create-font/editor",
	"version": "0.7.2",
	"description": "Interactive variable-font editor for the create-font state model",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/editor"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"src/browser-api.ts"
	],
	"exports": {
		".": {
			"types": "./src/browser-api.ts",
			"browser": "./dist/browser/editor.js",
			"import": "./dist/browser/editor.js"
		},
		"./browser": {
			"types": "./src/browser-api.ts",
			"browser": "./dist/browser/editor.js",
			"import": "./dist/browser/editor.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json --noEmit && bun run ./scripts/build.ts",
		"check:eslint": "eslint \"src/**/*.{ts,tsx}\"",
		"check:lasertag": "lasertag check \"src/**/*.module.css\"",
		"test": "vp test"
	},
	"dependencies": {
		"@create-font/states": "workspace:*"
	},
	"devDependencies": {
		"@create-font/preact-konva": "workspace:*",
		"@floating-ui/dom": "^1.8.0",
		"@radix-ui/react-icons": "^1.3.2",
		"@typescript-eslint/parser": "8.64.0",
		"@typescript-eslint/utils": "8.64.0",
		"atom.io": "0.50.1",
		"eslint": "10.7.0",
		"happy-dom": "20.11.0",
		"jiti": "2.7.0",
		"lasertag": "0.5.4",
		"preact": "10.29.7",
		"react": "npm:@preact/compat@18.3.2",
		"react-dom": "npm:@preact/compat@18.3.2",
		"treetrunks": "0.1.8",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": "26.5.0"
	}
}
