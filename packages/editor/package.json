{
	"name": "@trigraph/editor",
	"version": "0.0.0",
	"private": true,
	"description": "Interactive variable-font editor for the Trigraph state model",
	"type": "module",
	"exports": {
		".": "./src/EditorApplicationRoot.tsx",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json --noEmit",
		"check:eslint": "eslint \"src/**/*.{ts,tsx}\"",
		"check:lasertag": "lasertag check \"src/**/*.module.css\"",
		"test": "vp test"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@radix-ui/react-icons": "^1.3.2",
		"@trigraph/preact-konva": "workspace:*",
