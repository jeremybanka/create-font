{
	"name": "@create-font/editor",
	"version": "0.0.0",
	"description": "Interactive variable-font editor for the create-font state model",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/create-font",
		"directory": "packages/editor"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": ["src"],
	"exports": {
		".": "./src/EditorApplicationRoot.tsx",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json --noEmit",
		"check:eslint": "eslint \"src/**/*.{ts,tsx}\"",
		"check:lasertag": "lasertag check \"src/**/*.module.css\"",
		"test": "vp test"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@radix-ui/react-icons": "^1.3.2",
		"@create-font/preact-konva": "workspace:*",
		"@create-font/states": "workspace:*",
		"atom.io": "0.50.0",
		"preact": "10.29.7",
		"react": "npm:@preact/compat@18.3.2",
		"react-dom": "npm:@preact/compat@18.3.2",
		"treetrunks": "0.1.8"
	},
	"devDependencies": {
		"@typescript-eslint/parser": "8.64.0",
		"@typescript-eslint/utils": "8.64.0",
		"eslint": "10.7.0",
		"jiti": "2.7.0",
		"lasertag": "0.5.2",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": "26.5.0"
	}
}
