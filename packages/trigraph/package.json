{
	"name": "trigraph",
	"version": "0.0.0",
	"description": "A rigorously typed logical SFNT IR for OpenType variable TrueType fonts",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/*.d.mts",
