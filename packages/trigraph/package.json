{
	"name": "trigraph",
	"version": "0.0.0",
	"description": "Repository-local CLI and browser server for Trigraph font projects",
	"type": "module",
	"bin": {
		"trigraph": "./dist/cli.js"
	},
	"files": [
		"dist",
		"src",
		"tsconfig.json",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./src/server.ts",
			"bun": "./dist/server.js",
			"import": "./dist/server.js"
		},
		"./rpc": {
			"types": "./src/rpc.ts",
			"bun": "./dist/rpc.js",
			"import": "./dist/rpc.js"
		},
		"./rpc-client": {
			"types": "./src/rpc-client.ts",
			"browser": "./dist/rpc-client.js",
			"import": "./dist/rpc-client.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun run ./scripts/build.ts",
		"dev": "bun --watch ./src/cli.ts serve --root=../..",
		"test": "bun test"
	},
	"dependencies": {
		"@elysia/static": "1.4.11",
		"@trigraph/server": "workspace:*",
		"@trigraph/source": "workspace:*",
		"@trigraph/states": "workspace:*",
		"comline": "0.5.1",
		"elysia": "1.4.29",
		"preact": "10.29.7",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@trigraph/editor": "workspace:*",
		"@types/bun": "npm:bun-types@1.3.14",
		"@types/node": "25.9.5"
	}
}
